---
import "../styles/site.css";

const repos = [
  {
    name: "headroomlabs-ai/headroom",
    category: "Agentic systems",
    description: "Agentic workflows and prompt-heavy product work with a bias toward practical execution.",
    href: "https://github.com/headroomlabs-ai/headroom",
  },
  {
    name: "Graphify-Labs/graphify",
    category: "Structure extraction",
    description: "Graph-oriented thinking, relationship mapping, and visual structure for messy information spaces.",
    href: "https://github.com/Graphify-Labs/graphify",
  },
  {
    name: "Leonxlnx/agentic-ai-prompt-research",
    category: "Prompt research",
    description: "Research and testing patterns for agentic systems that need repeatability and control.",
    href: "https://github.com/Leonxlnx/agentic-ai-prompt-research",
  },
  {
    name: "msitarzewski/agency-agents",
    category: "Workflow experiments",
    description: "Agency-minded agent workflows and tools for getting from idea to usable system.",
    href: "https://github.com/msitarzewski/agency-agents",
  },
];

const principles = [
  "Open by default where it helps the project.",
  "Small, practical tools before broad platforms.",
  "Clear docs, clear ownership, clear next steps.",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Take It And Go is an independent Astro home for open-source releases with a bright sunrise identity."
    />
    <title>Take It And Go</title>
  </head>
  <body>
    <main class="takeitandgo">
      <section class="takeitandgo-hero">
        <div class="shell takeitandgo-hero__inner">
          <div class="takeitandgo-hero__copy">
            <p class="takeitandgo-kicker">Open source, shipped cleanly</p>
            <h1>Take it and go.</h1>
            <p class="takeitandgo-hero__lead">
              A bright, technically sharp home for open-source projects that deserve to
              look polished without feeling corporate. Fast to share, easy to scan, and
              built to stand on its own.
            </p>
            <div class="takeitandgo-hero__actions" id="access">
              <a class="button button--primary" href="#repos">View the first four</a>
              <a class="button button--secondary" href="#principles">Read the principles</a>
            </div>
          </div>

          <aside class="takeitandgo-hero__panel" aria-label="Project brief">
            <div class="takeitandgo-hero__panel-top">
              <span class="takeitandgo-hero__panel-label">takeitandgo.session</span>
              <span aria-hidden="true">✦</span>
            </div>
            <ul class="takeitandgo-hero__list">
              <li>
                <strong>Ship public early.</strong>
                <span>Put the repo in front of people before the polish becomes delay.</span>
              </li>
              <li>
                <strong>Keep the surface warm.</strong>
                <span>Bright, readable, and specific enough to feel trustworthy at first glance.</span>
              </li>
              <li>
                <strong>Leave room for more.</strong>
                <span>New projects should slot in without redesigning the system.</span>
              </li>
            </ul>
          </aside>
        </div>
      </section>

      <section class="takeitandgo-section" id="repos">
        <div class="shell">
          <div class="takeitandgo-section__heading">
            <p class="takeitandgo-kicker">Seed set</p>
            <h2>The first four projects are live on the page.</h2>
            <p>
              These are the initial repos we are surfacing. The page is structured so new
              projects can drop in without changing the visual system.
            </p>
          </div>

          <div class="takeitandgo-grid">
            {repos.map((repo, index) => (
              <article class="takeitandgo-card">
                <div class="takeitandgo-card__header">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span>{repo.category}</span>
                </div>
                <h3><a href={repo.href} target="_blank" rel="noreferrer">{repo.name}</a></h3>
                <p>{repo.description}</p>
                <a class="takeitandgo-card__link" href={repo.href} target="_blank" rel="noreferrer">
                  Open on GitHub
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="takeitandgo-section takeitandgo-section--split" id="principles">
        <div class="shell takeitandgo-split">
          <div class="takeitandgo-section__heading takeitandgo-section__heading--tight">
            <p class="takeitandgo-kicker">Principles</p>
            <h2>Open-source with teeth.</h2>
            <p>
              The product should feel independent, deliberate, and useful. It should read
              like a serious release channel, not a marketing wrapper.
            </p>
          </div>

          <div class="takeitandgo-principles">
            {principles.map((principle) => (
              <div class="takeitandgo-principle">{principle}</div>
            ))}
          </div>
        </div>
      </section>

      <footer class="takeitandgo-footer">
        <div class="shell takeitandgo-footer__inner">
          <span>Take It And Go</span>
          <span>Independent OSS release channel.</span>
        </div>
      </footer>
    </main>
  </body>
</html>
