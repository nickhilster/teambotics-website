---
import "../styles/site.css";

// The team submission inbox. Swap to a hosted form endpoint (Formspree,
// Web3Forms, etc.) by setting SUBMIT_ENDPOINT below; when it is empty the
// form falls back to composing an email to this address.
const SUBMIT_EMAIL = "hello@teambotics.com";
const SUBMIT_ENDPOINT = "";

type Project = {
  name: string;
  category: string;
  language: string;
  description: string;
  why: string;
  repo: string;
  audience: string;
  quickstart: string;
};

// A real, hand-checked shortlist. Every entry links to its actual repo.
const projects: Project[] = [
  {
    name: "ripgrep",
    category: "CLI",
    language: "Rust",
    description:
      "Recursively searches directories for a regex pattern and prints the matches, respecting your .gitignore by default.",
    why: "It is the search tool we reach for first. Fast enough that you stop batching greps and just ask.",
    repo: "https://github.com/BurntSushi/ripgrep",
    audience: "Anyone who still greps large trees by hand and wants an instant search that respects .gitignore.",
    quickstart: "rg 'TODO' --type js",
  },
  {
    name: "fzf",
    category: "CLI",
    language: "Go",
    description:
      "A general-purpose command-line fuzzy finder that plugs into shells, editors, and any pipeline that emits lines.",
    why: "One binary that quietly upgrades history search, file jumping, and git checkout. Learn it once, use it everywhere.",
    repo: "https://github.com/junegunn/fzf",
    audience: "Terminal users who want fuzzy history search, file-jumping, and git checkout without memorizing exact paths.",
    quickstart: "brew install fzf && vim $(fzf)",
  },
  {
    name: "htmx",
    category: "Web",
    language: "JavaScript",
    description:
      "Gives you AJAX, WebSockets, and server-sent events straight from HTML attributes, no build step required.",
    why: "A reminder that a lot of interactive UI never needed a framework. Great for small, sturdy interfaces.",
    repo: "https://github.com/bigskysoftware/htmx",
    audience: "Teams building small, sturdy UIs who don't want a full SPA framework's build step and bundle size.",
    quickstart: '<script src="https://unpkg.com/htmx.org"></script>',
  },
  {
    name: "Zod",
    category: "Web",
    language: "TypeScript",
    description:
      "TypeScript-first schema validation that infers your static types from a single source of truth.",
    why: "Write the schema once and get parsing, validation, and types for free. It removes a whole class of drift.",
    repo: "https://github.com/colinhacks/zod",
    audience: "TypeScript teams tired of writing runtime validation and static types twice for the same shape.",
    quickstart: "npm install zod",
  },
  {
    name: "Astro",
    category: "Web",
    language: "TypeScript",
    description:
      "A content-focused web framework that ships zero JavaScript by default and lets you bring any UI library you like.",
    why: "It is what this very page is built on. The islands model makes fast, mostly-static sites the easy path.",
    repo: "https://github.com/withastro/astro",
    audience: "Teams building mostly-static, content-heavy sites who want islands of interactivity, not a full SPA runtime.",
    quickstart: "npm create astro@latest",
  },
  {
    name: "Playwright",
    category: "Testing",
    language: "TypeScript",
    description:
      "Reliable end-to-end browser testing across Chromium, Firefox, and WebKit through one consistent API.",
    why: "Auto-waiting and honest tracing mean fewer flaky tests and faster answers when something breaks.",
    repo: "https://github.com/microsoft/playwright",
    audience: "QA and dev teams who want one API for end-to-end tests across Chromium, Firefox, and WebKit.",
    quickstart: "npm init playwright@latest",
  },
  {
    name: "DuckDB",
    category: "Data",
    language: "C++",
    description:
      "An in-process analytical SQL database — think SQLite, but built for fast queries over local files.",
    why: "Query a pile of CSV or Parquet files with real SQL and no server to stand up. It changes how you explore data.",
    repo: "https://github.com/duckdb/duckdb",
    audience: "Anyone with a pile of CSV or Parquet files who wants real SQL without spinning up a database server.",
    quickstart: "duckdb -c \"SELECT * FROM 'data.csv' LIMIT 5\"",
  },
  {
    name: "Meilisearch",
    category: "Data",
    language: "Rust",
    description:
      "A fast, typo-tolerant search engine you can drop into an app and have returning relevant results in minutes.",
    why: "Sensible defaults out of the box. You get search that feels good without tuning a heavyweight cluster.",
    repo: "https://github.com/meilisearch/meilisearch",
    audience: "Teams adding search to an app who want typo-tolerant, relevant results without tuning a heavyweight cluster.",
    quickstart: "curl -X POST 'http://localhost:7700/indexes/movies/documents' --data-binary @movies.json",
  },
  {
    name: "Caddy",
    category: "Self-hosting",
    language: "Go",
    description:
      "A web server with automatic HTTPS. Sensible defaults get a real site online from a one-line config.",
    why: "TLS certificates renew themselves and stay out of your way. The shortest honest path from box to live site.",
    repo: "https://github.com/caddyserver/caddy",
    audience: "Anyone self-hosting a site who wants HTTPS to just work without touching Certbot or nginx configs.",
    quickstart: "caddy reverse-proxy --from example.com --to localhost:3000",
  },
  {
    name: "Uptime Kuma",
    category: "Self-hosting",
    language: "JavaScript",
    description:
      "A self-hosted monitoring tool: a clean, friendly status page and alerting for the services you run.",
    why: "Set it up in an afternoon and finally know when something is down before your users tell you.",
    repo: "https://github.com/louislam/uptime-kuma",
    audience: "Self-hosters who want to know a service is down before a user tells them, without paying for a SaaS monitor.",
    quickstart: "docker run -d --name uptime-kuma -p 3001:3001 louislam/uptime-kuma",
  },
  {
    name: "Excalidraw",
    category: "Design",
    language: "TypeScript",
    description:
      "A virtual whiteboard for hand-drawn-style diagrams — fast, collaborative, and usable offline.",
    why: "The lo-fi look keeps diagrams feeling like thinking, not deliverables. Perfect for sketching a system live.",
    repo: "https://github.com/excalidraw/excalidraw",
    audience: "Teams who want to sketch a system or flow live on a call without their diagram looking like a deliverable.",
    quickstart: "npm install @excalidraw/excalidraw",
  },
  {
    name: "Biome",
    category: "Dev tools",
    language: "Rust",
    description:
      "One fast toolchain that formats and lints JavaScript and TypeScript, replacing several tools with a single binary.",
    why: "Near-instant runs and one config file. Less time arguing with tooling, more time writing the thing.",
    repo: "https://github.com/biomejs/biome",
    audience: "JS/TS teams tired of juggling ESLint, Prettier, and their conflicting configs across a monorepo.",
    quickstart: "npx @biomejs/biome check --write .",
  },
];

function slugify(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

function relatedPicks(project: Project, all: Project[]): Project[] {
  return all.filter((p) => p.category === project.category && p.name !== project.name).slice(0, 3);
}

function formatStars(count: number): string {
  if (count >= 1000) {
    return `${(count / 1000).toFixed(1)}k`;
  }
  return String(count);
}

type GithubStats = {
  stars: number;
  updatedLabel: string;
  openIssues: number;
};

function formatUpdatedLabel(pushedAt: string): string {
  const days = Math.floor((Date.now() - new Date(pushedAt).getTime()) / 86_400_000);
  if (days < 1) return "updated today";
  if (days < 30) return `updated ${days}d ago`;
  const months = Math.floor(days / 30);
  if (months < 12) return `updated ${months}mo ago`;
  return `updated ${Math.floor(months / 12)}y ago`;
}

async function fetchGithubStats(repoUrl: string): Promise<GithubStats | null> {
  const match = repoUrl.match(/github\.com\/([^/]+)\/([^/]+)/);
  if (!match) return null;
  const path = `${match[1]}/${match[2]}`;
  try {
    const response = await fetch(`https://api.github.com/repos/${path}`, {
      headers: {
        Accept: "application/vnd.github+json",
        "User-Agent": "takeitandgo-build",
      },
    });
    if (!response.ok) {
      console.warn(`GitHub stats fetch failed for ${path}: ${response.status}`);
      return null;
    }
    const data = await response.json();
    return {
      stars: data.stargazers_count,
      updatedLabel: formatUpdatedLabel(data.pushed_at),
      openIssues: data.open_issues_count,
    };
  } catch (error) {
    console.warn(`GitHub stats fetch errored for ${path}:`, error);
    return null;
  }
}

const githubStats = await Promise.all(projects.map((project) => fetchGithubStats(project.repo)));

const categories = ["All", ...Array.from(new Set(projects.map((p) => p.category)))];

const notes = [
  "We pick projects that feel generous: clear docs, sensible defaults, and code you can learn from.",
  "We care more about usefulness than novelty. A boring tool that saves a team an hour a day belongs here.",
  "We would rather explain why something matters than chase the hype around it.",
];

const submitCategories = categories.filter((c) => c !== "All");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Take It and Go is a monochrome curation desk: a short, browsable list of open-source projects worth grabbing, plus a form to send us one."
    />
    <meta name="color-scheme" content="dark light" />
    <title>Take It and Go — Open-source picks worth grabbing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("takeitandgo-theme");
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored === "light" || stored === "dark" ? stored : systemDark ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="page-texture" aria-hidden="true"></div>
    <header class="site-header">
      <div class="shell header-row">
        <a class="brand" href="/" aria-label="Take It and Go home">
          <span class="brand__badge" aria-hidden="true">TIG</span>
          <span class="brand__lockup">
            <strong>Take It and Go</strong>
            <span>Open-source picks from our team</span>
          </span>
        </a>

        <div class="header-actions">
          <button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="Switch color theme"
            aria-pressed="false"
          >
            <span class="theme-toggle__label">Theme</span>
            <span class="theme-toggle__value" id="theme-label">Dark</span>
          </button>

          <button
            class="menu-toggle"
            id="menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
          >
            <span>Menu</span>
          </button>
        </div>

        <nav class="site-nav" id="site-nav" aria-label="Primary">
          <a href="#picks">Project picks</a>
          <a href="#notes">Why these</a>
          <a href="#submit">Send us one</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="kicker">A short, browsable list of open-source projects we would hand to a friend</p>
            <h1>Good open-source, picked for you to take and go.</h1>
            <p class="hero-copy__lead">
              Take It and Go is a small curation desk. We keep the list tight, say why each
              project earns its place, and link you straight to the repo. Found one we should
              know about? Send it over.
            </p>
            <div class="hero-actions">
              <a class="button button--primary" href="#picks">Browse the picks</a>
              <a class="button button--secondary" href="#submit">Recommend a repo</a>
            </div>
          </div>

          <aside class="hero-panel" aria-labelledby="panel-title">
            <div class="eyebrow-row">
              <span class="eyebrow">Editorial note</span>
              <span class="eyebrow eyebrow--muted">Updated continuously</span>
            </div>
            <h2 id="panel-title">What makes the cut</h2>
            <ul class="checklist">
              <li>Readable docs before clever branding</li>
              <li>Useful defaults before enterprise theater</li>
              <li>Projects that teach something even if you never adopt them whole</li>
            </ul>
            <div class="status-strip" aria-live="polite">
              <span>{projects.length} picks on the list</span>
              <span>{categories.length - 1} categories</span>
              <span>Submissions open</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="section" id="picks">
        <div class="shell">
          <div class="section-head">
            <p class="section-label">Project picks</p>
            <h2>Projects we think more teams should know about.</h2>
            <p>
              Not a directory. Not a feed. A tighter list of repos we would actually share in a
              team channel, each with a line on why it is here. Filter by category or search to
              find one fast.
            </p>
          </div>

          <div class="browser">
            <div class="browser-toolbar">
              <div class="search-field">
                <label class="search-field__label" for="project-search">Search picks</label>
                <input
                  class="search-input"
                  id="project-search"
                  type="search"
                  inputmode="search"
                  autocomplete="off"
                  placeholder="Search by name or description…"
                  aria-controls="project-grid"
                />
              </div>

              <div class="filter-chips" role="group" aria-label="Filter by category">
                {categories.map((category, index) => (
                  <button
                    class="chip"
                    type="button"
                    data-filter={category}
                    aria-pressed={index === 0 ? "true" : "false"}
                  >
                    {category}
                  </button>
                ))}
              </div>
            </div>

            <p class="result-count" id="result-count" aria-live="polite">
              Showing {projects.length} of {projects.length} picks
            </p>

            <div class="project-grid" id="project-grid">
              {projects.map((project) => (
                <article
                  class="project-card"
                  data-category={project.category}
                  data-name={project.name.toLowerCase()}
                  data-description={project.description.toLowerCase()}
                >
                  <div class="project-card__meta">
                    <span>{project.category}</span>
                    <span class="chip chip--tag" aria-label={`Written in ${project.language}`}>
                      {project.language}
                    </span>
                  </div>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                  <p class="project-card__why">
                    <span class="project-card__why-label">Why we picked it</span>
                    {project.why}
                  </p>
                  <a class="project-link" href={project.repo} target="_blank" rel="noreferrer noopener">
                    View on GitHub
                    <span aria-hidden="true">↗</span>
                  </a>
                </article>
              ))}
            </div>

            <div class="message-card browser-empty" id="browser-empty" role="status" hidden>
              <strong>No picks match that filter.</strong>
              <p>
                Try a different category or a broader search. If we are missing something you
                love, that is a great reason to send it in.
              </p>
              <a class="text-link" href="#submit">Recommend a repo</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section section--divided" id="notes">
        <div class="shell split-layout">
          <div class="section-head section-head--tight">
            <p class="section-label">Why these</p>
            <h2>We curate like peers, not gatekeepers.</h2>
            <p>
              The point is to be opinionated in a useful way. If a project is here, we can
              explain what it helps with, where it fits, and what kind of team it serves.
            </p>
          </div>

          <div class="notes-stack">
            {notes.map((note, index) => (
              <article class="note-card">
                <span class="note-card__index">0{index + 1}</span>
                <p>{note}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="submit">
        <div class="shell submit-layout">
          <div class="section-head section-head--tight">
            <p class="section-label">Send us one</p>
            <h2>Know a repo that belongs here?</h2>
            <p>
              Tell us what it is and why it earned your trust. We read every submission and add
              the ones that fit. Nothing is stored on this page — submitting opens a pre-filled
              email to our desk so you can see exactly what you are sending.
            </p>
          </div>

          <form
            class="submit-form"
            id="submit-form"
            method="post"
            action={`mailto:${SUBMIT_EMAIL}`}
            enctype="text/plain"
            data-endpoint={SUBMIT_ENDPOINT}
            data-email={SUBMIT_EMAIL}
            novalidate
          >
            <div class="field">
              <label for="repo">Repository URL <span class="field__req" aria-hidden="true">required</span></label>
              <input
                id="repo"
                name="repo"
                type="url"
                required
                placeholder="https://github.com/owner/project"
                autocomplete="url"
              />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="project-name">Project name</label>
                <input id="project-name" name="project" type="text" placeholder="What is it called?" />
              </div>

              <div class="field">
                <label for="category">Category</label>
                <select id="category" name="category">
                  <option value="">Pick one (optional)</option>
                  {submitCategories.map((category) => (
                    <option value={category}>{category}</option>
                  ))}
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>

            <div class="field">
              <label for="why">Why is it worth sharing? <span class="field__req" aria-hidden="true">required</span></label>
              <textarea
                id="why"
                name="why"
                rows="4"
                required
                placeholder="What does it do well, and who should grab it?"
              ></textarea>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="submitter">Your name</label>
                <input id="submitter" name="name" type="text" placeholder="Optional" autocomplete="name" />
              </div>

              <div class="field">
                <label for="email">Your email</label>
                <input id="email" name="email" type="email" placeholder="Optional, for follow-up" autocomplete="email" />
              </div>
            </div>

            <div class="submit-form__footer">
              <button class="button button--primary" type="submit">Send this pick</button>
              <span class="submit-form__hint" id="submit-hint">We only use your email to follow up on this pick.</span>
            </div>

            <div class="message-card message-card--error" id="submit-error" role="alert" hidden></div>
            <div class="message-card submit-success" id="submit-success" role="status" hidden>
              <strong>Thanks — your email is ready to send.</strong>
              <p id="submit-success-copy">
                We just opened a pre-filled message in your email app. Hit send and it lands on
                our desk. If nothing opened, use the direct link below.
              </p>
              <a class="text-link" id="submit-mailto" href={`mailto:${SUBMIT_EMAIL}`}>Email us directly</a>
            </div>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-row">
        <p>Take It and Go is a small curation desk for open-source work we think deserves more eyes.</p>
        <a class="text-link" href="#picks">Go back to the shortlist</a>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeToggle = document.getElementById("theme-toggle");
        const themeLabel = document.getElementById("theme-label");
        const menuToggle = document.getElementById("menu-toggle");
        const nav = document.getElementById("site-nav");

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          localStorage.setItem("takeitandgo-theme", theme);
          if (themeToggle instanceof HTMLButtonElement) {
            themeToggle.setAttribute("aria-pressed", String(theme === "light"));
          }
          if (themeLabel) {
            themeLabel.textContent = theme === "dark" ? "Dark" : "Light";
          }
        };

        applyTheme(root.dataset.theme === "light" ? "light" : "dark");

        if (themeToggle instanceof HTMLButtonElement) {
          themeToggle.addEventListener("click", () => {
            applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
          });
        }

        if (menuToggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
          const closeMenu = () => {
            nav.dataset.open = "false";
            menuToggle.setAttribute("aria-expanded", "false");
          };

          menuToggle.addEventListener("click", () => {
            const next = nav.dataset.open !== "true";
            nav.dataset.open = String(next);
            menuToggle.setAttribute("aria-expanded", String(next));
          });

          nav.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
          });

          window.addEventListener("resize", () => {
            if (window.innerWidth >= 768) {
              closeMenu();
            }
          });
        }

        // ---- Browse + filter the picks ----
        const search = document.getElementById("project-search");
        const chips = Array.from(document.querySelectorAll(".chip[data-filter]"));
        const cards = Array.from(document.querySelectorAll(".project-card"));
        const count = document.getElementById("result-count");
        const empty = document.getElementById("browser-empty");
        const total = cards.length;
        let activeCategory = "All";

        const applyFilters = () => {
          const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
          let shown = 0;

          cards.forEach((card) => {
            const category = card.getAttribute("data-category") || "";
            const name = card.getAttribute("data-name") || "";
            const description = card.getAttribute("data-description") || "";
            const matchesCategory = activeCategory === "All" || category === activeCategory;
            const matchesQuery = query === "" || name.includes(query) || description.includes(query);
            const visible = matchesCategory && matchesQuery;
            card.hidden = !visible;
            if (visible) shown += 1;
          });

          if (count) {
            count.textContent = `Showing ${shown} of ${total} picks`;
          }
          if (empty) {
            empty.hidden = shown !== 0;
          }
        };

        chips.forEach((chip) => {
          chip.addEventListener("click", () => {
            activeCategory = chip.getAttribute("data-filter") || "All";
            chips.forEach((other) => {
              other.setAttribute("aria-pressed", String(other === chip));
            });
            applyFilters();
          });
        });

        if (search instanceof HTMLInputElement) {
          search.addEventListener("input", applyFilters);
        }

        // ---- Submission form ----
        const form = document.getElementById("submit-form");
        const errorBox = document.getElementById("submit-error");
        const successBox = document.getElementById("submit-success");
        const successCopy = document.getElementById("submit-success-copy");
        const mailtoLink = document.getElementById("submit-mailto");

        if (form instanceof HTMLFormElement) {
          const email = form.getAttribute("data-email") || "";
          const endpoint = form.getAttribute("data-endpoint") || "";

          const showError = (message) => {
            if (errorBox) {
              errorBox.textContent = message;
              errorBox.hidden = false;
            }
            if (successBox) successBox.hidden = true;
          };

          const buildMailto = (data) => {
            const subject = `Take It and Go submission: ${data.project || data.repo}`;
            const lines = [
              `Repository: ${data.repo}`,
              `Project: ${data.project || "(not given)"}`,
              `Category: ${data.category || "(not given)"}`,
              "",
              "Why it is worth sharing:",
              data.why,
              "",
              `From: ${data.name || "(anonymous)"}${data.email ? ` <${data.email}>` : ""}`,
            ];
            return `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
          };

          form.addEventListener("submit", (event) => {
            event.preventDefault();

            const data = {
              repo: (form.elements.namedItem("repo") || {}).value?.trim() || "",
              project: (form.elements.namedItem("project") || {}).value?.trim() || "",
              category: (form.elements.namedItem("category") || {}).value || "",
              why: (form.elements.namedItem("why") || {}).value?.trim() || "",
              name: (form.elements.namedItem("name") || {}).value?.trim() || "",
              email: (form.elements.namedItem("email") || {}).value?.trim() || "",
            };

            if (!data.repo) {
              showError("Please add the repository URL so we know what to look at.");
              return;
            }
            try {
              // Validate the URL shape without being too strict about the host.
              // eslint-disable-next-line no-new
              new URL(data.repo);
            } catch {
              showError("That repository URL does not look right. Include the full https:// address.");
              return;
            }
            if (!data.why) {
              showError("Tell us why it is worth sharing — that context is the whole point.");
              return;
            }

            if (errorBox) errorBox.hidden = true;

            // If a hosted endpoint is configured, POST there. Otherwise compose
            // an email the sender can review and send.
            if (endpoint) {
              fetch(endpoint, {
                method: "POST",
                headers: { "Content-Type": "application/json", Accept: "application/json" },
                body: JSON.stringify(data),
              })
                .then((response) => {
                  if (!response.ok) throw new Error("Bad response");
                  if (successCopy) {
                    successCopy.textContent = "We got it. Thanks for the pick — we will take a look.";
                  }
                  if (successBox) successBox.hidden = false;
                  form.reset();
                })
                .catch(() => {
                  showError("Something went wrong sending that. Please try the direct email link below.");
                  if (successBox) successBox.hidden = false;
                });
              return;
            }

            const mailto = buildMailto(data);
            if (mailtoLink instanceof HTMLAnchorElement) {
              mailtoLink.href = mailto;
            }
            if (successBox) successBox.hidden = false;
            window.location.href = mailto;
          });
        }
      })();
    </script>
  </body>
</html>
