---
import "../styles/site.css";

const projects = [
  {
    name: "Docs That Do Not Rot",
    category: "Knowledge ops",
    description:
      "A clean documentation workflow for teams that want useful reference material instead of abandoned wikis.",
    cta: "Open the repo",
    href: "#picks",
  },
  {
    name: "Signal Over Dashboard",
    category: "Workflow tooling",
    description:
      "A small internal tool that cuts ceremony and gives operators the shortest path to the next meaningful action.",
    cta: "Read why we kept it",
    href: "#notes",
  },
  {
    name: "Ship Notes",
    category: "Release habits",
    description:
      "A release log pattern that makes open-source projects easier to trust, fork, and maintain in public.",
    cta: "See the review notes",
    href: "#states",
  },
  {
    name: "Practical Guardrails",
    category: "Engineering hygiene",
    description:
      "A checklist for teams that want fast-moving repos without accepting mystery behavior as the price of speed.",
    cta: "Browse the checklist",
    href: "#notes",
  },
  {
    name: "Small OSS, Big Leverage",
    category: "Team curation",
    description:
      "Examples of quiet open-source utilities that save real time even if they never hit a front page.",
    cta: "Explore the shortlist",
    href: "#picks",
  },
  {
    name: "Public by Default",
    category: "Community practice",
    description:
      "Notes on sharing work early, documenting tradeoffs honestly, and giving people something they can actually use.",
    cta: "Read the rationale",
    href: "#notes",
  },
];

const notes = [
  "We pick projects that feel generous: clear docs, sensible defaults, and code you can learn from.",
  "We care more about usefulness than novelty. A boring tool that saves a team an hour a day belongs here.",
  "We would rather explain why something matters than chase hype around it.",
];

const tokens = [
  { label: "color.background", value: "#000 / #fff" },
  { label: "color.foreground", value: "#fff / #000" },
  { label: "color.surface", value: "rgba(foreground, 0.04-0.08)" },
  { label: "color.border", value: "rgba(foreground, 0.16-0.24)" },
  { label: "radius", value: "2px / 4px" },
  { label: "spacing", value: "4, 8, 12, 16, 24, 32, 48, 72" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Take It and Go is a monochrome curation hub where a team shares open-source projects worth knowing about."
    />
    <meta name="color-scheme" content="dark light" />
    <title>Take It and Go</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("takeitandgo-theme");
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored === "light" || stored === "dark" ? stored : systemDark ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="page-texture" aria-hidden="true"></div>
    <header class="site-header">
      <div class="shell header-row">
        <a class="brand" href="/" aria-label="Take It and Go home">
          <span class="brand__badge" aria-hidden="true">TIG</span>
          <span class="brand__lockup">
            <strong>Take It and Go</strong>
            <span>Open-source picks from our team</span>
          </span>
        </a>

        <div class="header-actions">
          <button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="Switch color theme"
            aria-pressed="false"
          >
            <span class="theme-toggle__label">Theme</span>
            <span class="theme-toggle__value" id="theme-label">Dark</span>
          </button>

          <button
            class="menu-toggle"
            id="menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
          >
            <span>Menu</span>
          </button>
        </div>

        <nav class="site-nav" id="site-nav" aria-label="Primary">
          <a href="#picks">Project picks</a>
          <a href="#notes">Why these</a>
          <a href="#states">States and specs</a>
          <a href="#submit">Send us one</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="kicker">A running shortlist of open-source projects we would hand to a friend</p>
            <h1>We find good open-source work and point people to it.</h1>
            <p class="hero-copy__lead">
              Take It and Go is where our team shares projects worth stealing time for:
              tools with clear thinking, solid craft, and enough generosity to help the
              next builder move faster.
            </p>
            <div class="hero-actions">
              <a class="button button--primary" href="#picks">Browse this week&apos;s picks</a>
              <a class="button button--secondary" href="#submit">Recommend a repo to us</a>
            </div>
          </div>

          <aside class="hero-panel" aria-labelledby="panel-title">
            <div class="eyebrow-row">
              <span class="eyebrow">Editorial note</span>
              <span class="eyebrow eyebrow--muted">Updated continuously</span>
            </div>
            <h2 id="panel-title">What makes the cut</h2>
            <ul class="checklist">
              <li>Readable docs before clever branding</li>
              <li>Useful defaults before enterprise theater</li>
              <li>Projects that teach something even if you never adopt them whole</li>
            </ul>
            <div class="status-strip" aria-live="polite">
              <span>6 picks on deck</span>
              <span>3 notes in review</span>
              <span>1 open submission inbox</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="section" id="picks">
        <div class="shell">
          <div class="section-head">
            <p class="section-label">Project picks</p>
            <h2>Projects we think more teams should know about.</h2>
            <p>
              Not a directory. Not a feed. Just a tighter list of repos, tools, and
              patterns we would actually share in a team channel with context.
            </p>
          </div>

          <div class="project-grid">
            {projects.map((project) => (
              <article class="project-card">
                <div class="project-card__meta">
                  <span>{project.category}</span>
                  <span>Curated pick</span>
                </div>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <a class="project-link" href={project.href}>{project.cta}</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--divided" id="notes">
        <div class="shell split-layout">
          <div class="section-head section-head--tight">
            <p class="section-label">Why these</p>
            <h2>We curate like peers, not gatekeepers.</h2>
            <p>
              The point is to be opinionated in a useful way. If a project is here, we can
              explain what it helps with, where it fits, and what kind of team it serves.
            </p>
          </div>

          <div class="notes-stack">
            {notes.map((note, index) => (
              <article class="note-card">
                <span class="note-card__index">0{index + 1}</span>
                <p>{note}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="states">
        <div class="shell">
          <div class="section-head">
            <p class="section-label">States and specs</p>
            <h2>Every interactive surface has a visible state.</h2>
            <p>
              This page is designed as a working component spec: the tokens are explicit,
              the controls are testable, and the empty or broken moments are written on
              purpose instead of left to chance.
            </p>
          </div>

          <div class="spec-grid">
            <article class="spec-card">
              <h3>Design tokens</h3>
              <ul class="token-list">
                {tokens.map((token) => (
                  <li>
                    <span>{token.label}</span>
                    <strong>{token.value}</strong>
                  </li>
                ))}
              </ul>
            </article>

            <article class="spec-card">
              <h3>Type scale</h3>
              <ul class="type-list">
                <li><span class="type-display">Display</span></li>
                <li><span class="type-h1">H1</span></li>
                <li><span class="type-h2">H2</span></li>
                <li><span class="type-body">Body</span></li>
                <li><span class="type-caption">Caption</span></li>
                <li><span class="type-label">Label</span></li>
              </ul>
            </article>
          </div>

          <div class="state-grid" aria-label="Interaction states">
            <article class="state-card">
              <span class="state-card__label">Default / Hover / Active</span>
              <button class="button button--primary" type="button">Primary action</button>
              <button class="button button--secondary" type="button">Secondary action</button>
              <a class="text-link" href="#submit">Inline link state</a>
            </article>

            <article class="state-card">
              <span class="state-card__label">Focus ready</span>
              <button class="button button--secondary" type="button">Tab to reveal ring</button>
              <button class="theme-toggle theme-toggle--demo" type="button" aria-pressed="true">
                <span class="theme-toggle__label">Theme</span>
                <span class="theme-toggle__value">Light</span>
              </button>
            </article>

            <article class="state-card">
              <span class="state-card__label">Disabled</span>
              <button class="button button--primary" type="button" disabled>Curating now</button>
              <a class="text-link is-disabled" aria-disabled="true">Link unavailable</a>
            </article>

            <article class="state-card">
              <span class="state-card__label">Loading / Skeleton</span>
              <div class="loading-card" aria-busy="true" aria-label="Loading project card">
                <span class="skeleton skeleton--short"></span>
                <span class="skeleton skeleton--title"></span>
                <span class="skeleton skeleton--line"></span>
                <span class="skeleton skeleton--line"></span>
              </div>
            </article>

            <article class="state-card">
              <span class="state-card__label">Error</span>
              <div class="message-card message-card--error" role="status">
                <strong>We could not load the latest repo notes.</strong>
                <p>The source is unavailable right now. Check back or open the project directly.</p>
              </div>
            </article>

            <article class="state-card" id="submit">
              <span class="state-card__label">Empty</span>
              <div class="message-card">
                <strong>No new submissions yet.</strong>
                <p>
                  That is fine. We would rather post a short list with conviction than pad it
                  with filler.
                </p>
                <a class="text-link" href="mailto:hello@teambotics.com">Send a repo for review</a>
              </div>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-row">
        <p>Take It and Go is a small curation desk for open-source work we think deserves more eyes.</p>
        <a class="text-link" href="#picks">Go back to the shortlist</a>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeToggle = document.getElementById("theme-toggle");
        const themeLabel = document.getElementById("theme-label");
        const menuToggle = document.getElementById("menu-toggle");
        const nav = document.getElementById("site-nav");

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          localStorage.setItem("takeitandgo-theme", theme);
          if (themeToggle instanceof HTMLButtonElement) {
            themeToggle.setAttribute("aria-pressed", String(theme === "light"));
          }
          if (themeLabel) {
            themeLabel.textContent = theme === "dark" ? "Dark" : "Light";
          }
        };

        applyTheme(root.dataset.theme === "light" ? "light" : "dark");

        if (themeToggle instanceof HTMLButtonElement) {
          themeToggle.addEventListener("click", () => {
            applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
          });
        }

        if (menuToggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
          const closeMenu = () => {
            nav.dataset.open = "false";
            menuToggle.setAttribute("aria-expanded", "false");
          };

          menuToggle.addEventListener("click", () => {
            const next = nav.dataset.open !== "true";
            nav.dataset.open = String(next);
            menuToggle.setAttribute("aria-expanded", String(next));
          });

          nav.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
          });

          window.addEventListener("resize", () => {
            if (window.innerWidth >= 768) {
              closeMenu();
            }
          });
        }
      })();
    </script>
  </body>
</html>
