---
import '../styles/tokens.css';
import '../styles/blog.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'Insights on industrial automation and robotics from the Teambotics team.', ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const brandAssetBase = 'https://teambotics.app/brand';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={`${brandAssetBase}/teambotics-logo-32.png`} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script>
      const nodes = document.querySelectorAll('.mermaid');
      if (nodes.length > 0) {
        const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'neutral' });
        await mermaid.run({ nodes: Array.from(nodes) as HTMLElement[] });
      }
    </script>
  </head>
  <body>
    <header class="blog-header">
      <div class="blog-header__inner">
        <a href="https://blog.teambotics.app" class="blog-header__brand">
          <picture class="blog-header__logo">
            <source
              media="(max-width: 719px)"
              srcSet={`${brandAssetBase}/teambotics-logo-24.png 1x, ${brandAssetBase}/teambotics-logo-48.png 2x`}
            />
            <img
              alt=""
              decoding="async"
              height="28"
              src={`${brandAssetBase}/teambotics-logo-28.png`}
              srcSet={`${brandAssetBase}/teambotics-logo-28.png 1x, ${brandAssetBase}/teambotics-logo-56.png 2x`}
              width="28"
            />
          </picture>
          <span class="blog-header__site-name">Teambotics Blog</span>
        </a>
        <nav class="blog-header__nav">
          <a href="https://teambotics.app" class="blog-header__nav-link" target="_blank" rel="noopener noreferrer">
            Main site ↗
          </a>
        </nav>
      </div>
    </header>

    <main class="blog-main">
      <slot />
    </main>

    <footer class="blog-footer">
      <div class="blog-footer__inner">
        <p>© {new Date().getFullYear()} Teambotics. All rights reserved.</p>
        <a href="https://teambotics.app" class="blog-footer__link" target="_blank" rel="noopener noreferrer">teambotics.app</a>
      </div>
    </footer>
  </body>
</html>
