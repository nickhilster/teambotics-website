---
import { getGeometricThumbnailUrl } from '../lib/thumbnail.ts';

interface Props {
  post: {
    slug: string;
    title: string;
    excerpt: string;
    author: string;
    tags: string[];
    cover_image_url: string | null;
    published_at: string | null;
  };
}

const { post } = Astro.props;
const coverImage = post.cover_image_url ?? getGeometricThumbnailUrl(post.slug);

function formatDate(iso: string | null) {
  if (!iso) return null;
  return new Date(iso).toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

const date = formatDate(post.published_at);
---

<article class="post-card">
  <img
    src={coverImage}
    alt={post.title}
    class="post-card__cover"
    loading="lazy"
  />

  <div class="post-card__body">
    {post.tags.length > 0 && (
      <div class="post-card__tags">
        {post.tags.slice(0, 3).map((tag) => (
          <span class="post-card__tag">{tag}</span>
        ))}
      </div>
    )}

    <a href={`/${post.slug}`} class="post-card__title">{post.title}</a>

    {post.excerpt && (
      <p class="post-card__excerpt">{post.excerpt}</p>
    )}

    <div class="post-card__meta">
      <span>{post.author}</span>
      {date && (
        <>
          <span class="post-card__meta-sep">·</span>
          <time datetime={post.published_at!}>{date}</time>
        </>
      )}
    </div>
  </div>
</article>
