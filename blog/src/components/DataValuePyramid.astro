---
// Interactive pyramid showing operational data sources ranked by AI value ROI
---

<div class="data-pyramid">
  <style>
    .data-pyramid {
      width: 100%;
      margin: 2rem 0;
    }

    .dp-title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-tertiary);
      text-align: center;
      margin-bottom: 1.25rem;
    }

    .dp-container {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .dp-layer {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--color-border);
      padding: 0.75rem 1.25rem;
      cursor: pointer;
      transition: all 0.25s ease;
      position: relative;
      overflow: hidden;
    }

    .dp-layer:nth-child(1) { width: 45%; background: rgba(255, 107, 107, 0.08); border-color: rgba(255, 107, 107, 0.25); }
    .dp-layer:nth-child(2) { width: 58%; background: rgba(255, 159, 64, 0.08); border-color: rgba(255, 159, 64, 0.25); }
    .dp-layer:nth-child(3) { width: 71%; background: rgba(255, 206, 86, 0.08); border-color: rgba(255, 206, 86, 0.25); }
    .dp-layer:nth-child(4) { width: 84%; background: rgba(75, 192, 100, 0.08); border-color: rgba(75, 192, 100, 0.25); }
    .dp-layer:nth-child(5) { width: 100%; background: rgba(99, 179, 237, 0.08); border-color: rgba(99, 179, 237, 0.25); }

    .dp-layer:hover,
    .dp-layer.active {
      transform: scale(1.015);
      filter: brightness(1.2);
    }

    .dp-layer-icon { font-size: 1.1rem; }

    .dp-layer-name {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text-primary);
    }

    .dp-layer-badge {
      margin-left: auto;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .dp-layer:nth-child(1) .dp-layer-badge { background: rgba(255, 107, 107, 0.2); color: #ff6b6b; }
    .dp-layer:nth-child(2) .dp-layer-badge { background: rgba(255, 159, 64, 0.2); color: #ff9f40; }
    .dp-layer:nth-child(3) .dp-layer-badge { background: rgba(255, 206, 86, 0.2); color: #b8920a; }
    .dp-layer:nth-child(4) .dp-layer-badge { background: rgba(75, 192, 100, 0.2); color: #4bc064; }
    .dp-layer:nth-child(5) .dp-layer-badge { background: rgba(99, 179, 237, 0.2); color: #63b3ed; }

    .dp-detail {
      padding: 1.25rem;
      background: var(--color-bg-elevated);
      border-radius: var(--radius-xl);
      border: 1px solid var(--color-border);
      min-height: 100px;
      animation: slideUp 0.25s ease;
    }

    .dp-detail-header {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.5rem;
    }

    .dp-detail-icon { font-size: 1.25rem; }

    .dp-detail-name {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--color-text-primary);
    }

    .dp-detail-desc {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.55;
    }

    .dp-legend {
      display: flex;
      justify-content: space-between;
      margin-top: 1rem;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-tertiary);
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 639px) {
      /* Full-width on mobile — pyramid shape is too narrow to tap */
      .dp-layer:nth-child(1),
      .dp-layer:nth-child(2),
      .dp-layer:nth-child(3),
      .dp-layer:nth-child(4),
      .dp-layer:nth-child(5) { width: 100%; }
      .dp-layer { min-height: 52px; padding: 0.85rem 1rem; }
      .dp-layer-badge { display: none; }
    }
  </style>

  <div class="dp-title">Operational Data Sources — Ranked by AI Value ROI</div>

  <div class="dp-container">
    <div class="dp-layer" data-key="maintenance">
      <div class="dp-layer-icon">🔧</div>
      <div class="dp-layer-name">Maintenance &amp; Fault Logs</div>
      <div class="dp-layer-badge">Highest ROI</div>
    </div>
    <div class="dp-layer" data-key="quality">
      <div class="dp-layer-icon">✅</div>
      <div class="dp-layer-name">Quality Inspection Records</div>
      <div class="dp-layer-badge">Very High</div>
    </div>
    <div class="dp-layer" data-key="incidents">
      <div class="dp-layer-icon">⚠️</div>
      <div class="dp-layer-name">Incident &amp; Near-Miss Reports</div>
      <div class="dp-layer-badge">High</div>
    </div>
    <div class="dp-layer" data-key="handover">
      <div class="dp-layer-icon">📋</div>
      <div class="dp-layer-name">Shift Handover Notes</div>
      <div class="dp-layer-badge">High</div>
    </div>
    <div class="dp-layer" data-key="sops">
      <div class="dp-layer-icon">📄</div>
      <div class="dp-layer-name">SOPs &amp; Work Instructions</div>
      <div class="dp-layer-badge">Foundation</div>
    </div>
  </div>

  <div class="dp-detail" id="dp-detail">
    <div class="dp-detail-header">
      <div class="dp-detail-icon">🔧</div>
      <div class="dp-detail-name">Maintenance &amp; Fault Logs</div>
    </div>
    <div class="dp-detail-desc">Contains the accumulated diagnostic knowledge of your engineering team. Patterns in failure modes, environmental conditions that precede breakdowns, and the interventions that worked — precisely the knowledge that walks out the door when experienced technicians retire.</div>
  </div>

  <div class="dp-legend">
    <span>↑ Highest AI ROI</span>
    <span>Click any layer to explore →</span>
    <span>Foundational ↓</span>
  </div>

  <script>
    const pyramidData = {
      maintenance: {
        icon: '🔧',
        name: 'Maintenance & Fault Logs',
        desc: 'Contains the accumulated diagnostic knowledge of your engineering team. Patterns in failure modes, environmental conditions that precede breakdowns, and the interventions that worked — precisely the knowledge that walks out the door when experienced technicians retire.'
      },
      quality: {
        icon: '✅',
        name: 'Quality Inspection Records',
        desc: 'Pass/fail records, defect classifications, and operator notes from inspection points. Over a long enough time horizon, these reveal the upstream conditions that predict quality failure downstream — before it happens.'
      },
      incidents: {
        icon: '⚠️',
        name: 'Incident & Near-Miss Reports',
        desc: 'Regulatory environments require these, which means most organisations have them — and rarely mine them for patterns. An AI system that can surface "the last five incidents involving this equipment all occurred within 30 days of a particular maintenance cycle" provides genuine risk intelligence.'
      },
      handover: {
        icon: '📋',
        name: 'Shift Handover Notes',
        desc: 'Informal, often poorly structured, but rich with context that does not make it into formal systems. "Pump was making noise before we stopped it" tells a story that no sensor reading captures. Often the least structured and most information-rich source in the organisation.'
      },
      sops: {
        icon: '📄',
        name: 'SOPs & Work Instructions',
        desc: 'Often treated as static compliance artefacts. In practice, they are a knowledge graph of your processes. An AI trained on your SOPs can answer "what is the correct restart sequence for Unit 7 after an emergency stop?" without paging an engineer.'
      }
    };

    const layers = document.querySelectorAll('.dp-layer');
    const detail = document.getElementById('dp-detail');

    function showDetail(key) {
      layers.forEach(l => l.classList.remove('active'));
      const layer = document.querySelector(`[data-key="${key}"]`);
      if (layer) layer.classList.add('active');
      const d = pyramidData[key];
      if (!d) return;
      detail.innerHTML = `
        <div class="dp-detail-header">
          <div class="dp-detail-icon">${d.icon}</div>
          <div class="dp-detail-name">${d.name}</div>
        </div>
        <div class="dp-detail-desc">${d.desc}</div>
      `;
    }

    layers.forEach(layer => {
      layer.addEventListener('click', () => showDetail(layer.dataset.key));
      // hover only on pointer devices
      layer.addEventListener('mouseenter', () => showDetail(layer.dataset.key));
    });

    // Activate first layer
    if (layers.length) showDetail(layers[0].dataset.key);
  </script>
</div>
