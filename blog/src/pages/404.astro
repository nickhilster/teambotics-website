    <p class="blog-404__code">404</p>
    <h1 class="blog-404__title">Page not found</h1>
    <p class="blog-404__body">
      The post you&apos;re looking for doesn&apos;t exist or may have been moved.
    </p>
    <a href="/" class="blog-404__link">← Back to blog</a>
  </div>
</BlogLayout>
