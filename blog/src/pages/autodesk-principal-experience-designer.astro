---
import BlogLayout from '../layouts/BlogLayout.astro';

const title = 'Nikhil Khedkar for Autodesk — Principal Experience Designer';
const description =
  'A public application page for Autodesk Principal Experience Designer, focused on Autodesk Assistant, agentic UX, professional tool workflows, and responsible AI interaction patterns.';
---

<BlogLayout title={title} description={description}>
  <article class="autodesk-application" aria-labelledby="application-title">
    <section class="autodesk-hero">
      <div class="autodesk-hero__content">
        <p class="autodesk-kicker">Public application · Principal Experience Designer · Autodesk Assistant</p>
        <h1 id="application-title">AI interaction patterns for professionals who design and make.</h1>
        <p class="autodesk-hero__lead">
          Autodesk Assistant should not feel like a chatbot bolted onto expert software. It should feel grounded,
          controllable, reversible, and respectful of the user’s craft.
        </p>
        <div class="autodesk-actions" aria-label="Candidate links">
          <a href="https://www.linkedin.com/in/nikhil-khedkar" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href="https://www.teambotics.app/" target="_blank" rel="noopener noreferrer">TeamBotics ↗</a>
          <a href="mailto:nickhilster@gmail.com">Contact</a>
        </div>
      </div>
      <aside class="autodesk-signal-card" aria-label="Why this role fits">
        <p class="autodesk-card-label">Why this role fits</p>
        <p>
          I bring a rare bridge: lived 3D production fluency from Maya and 3ds Max-era workflows, plus current
          AI product work focused on assistant behaviour, prompt UX, trust patterns, and human-in-the-loop control.
        </p>
      </aside>
    </section>

    <section class="autodesk-section" aria-labelledby="fit-title">
      <div class="autodesk-section__intro">
        <p class="autodesk-kicker">Fit snapshot</p>
        <h2 id="fit-title">The role is not simply AI. It is professional trust at platform scale.</h2>
      </div>
      <div class="autodesk-grid">
        <div class="autodesk-card">
          <p class="autodesk-card-label">01 / Agentic UX</p>
          <h3>Control before magic</h3>
          <p>
            Designing AI states around user intent, assumptions, editable outputs, retry and undo paths, and recovery
            from bad answers.
          </p>
        </div>
        <div class="autodesk-card">
          <p class="autodesk-card-label">02 / Professional tools</p>
          <h3>Expert users, real stakes</h3>
          <p>
            3D, VFX, production, and workflow experience creates empathy for dense software, deadline pressure, and
            domain-specific judgment.
          </p>
        </div>
        <div class="autodesk-card">
          <p class="autodesk-card-label">03 / Platform patterns</p>
          <h3>Reusable systems</h3>
          <p>
            Thinking in repeatable patterns: assistant behaviours, fit matrices, documentation, onboarding, product
            narratives, and cross-functional adoption.
          </p>
        </div>
      </div>
    </section>

    <section class="autodesk-section autodesk-section--ruled" aria-labelledby="proof-title">
      <div class="autodesk-section__intro">
        <p class="autodesk-kicker">Relevant proof</p>
        <h2 id="proof-title">Applied AI work mapped to Autodesk Assistant.</h2>
      </div>
      <div class="autodesk-work-list">
        <div class="autodesk-work-row">
          <h3>TeamBotics</h3>
          <p>
            Applied AI product studio focused on human-first AI, workflow assistants, adoption patterns, and role-specific
            product systems.
          </p>
          <a href="https://www.teambotics.app/" target="_blank" rel="noopener noreferrer">View ↗</a>
        </div>
        <div class="autodesk-work-row">
          <h3>RyFine</h3>
          <p>
            Prompt-refinement product demonstrating prompt UX, provider-aware workflows, reusable prompt libraries,
            user education, and local-first thinking.
          </p>
          <a href="https://www.ryfine.app/" target="_blank" rel="noopener noreferrer">View ↗</a>
        </div>
        <div class="autodesk-work-row">
          <h3>LTB Buddy</h3>
          <p>
            Trust-sensitive workflow assistant concept for regulated, document-heavy user journeys. Relevant to boundaries,
            grounding, intake, and safe guidance.
          </p>
          <a href="https://www.teambotics.app/products/ltb-buddy" target="_blank" rel="noopener noreferrer">View ↗</a>
        </div>
        <div class="autodesk-work-row">
          <h3>EasyBuddy</h3>
          <p>
            AI onboarding and coaching assistant for workplace learning and role-based guidance. Relevant to Autodesk
            Assistant as an expert support layer.
          </p>
          <a href="https://www.teambotics.app/products/easybuddy" target="_blank" rel="noopener noreferrer">View ↗</a>
        </div>
      </div>
    </section>

    <section class="autodesk-section autodesk-section--light" aria-labelledby="timeline-title">
      <div class="autodesk-section__intro">
        <p class="autodesk-kicker">First 90 days</p>
        <h2 id="timeline-title">A practical contribution path.</h2>
      </div>
      <div class="autodesk-steps">
        <div class="autodesk-step">
          <h3>Days 1–30</h3>
          <p>
            Map product surfaces, assistant behaviours, stakeholder needs, user risk, existing pattern libraries, and
            current Autodesk Assistant evaluation signals.
          </p>
        </div>
        <div class="autodesk-step">
          <h3>Days 31–60</h3>
          <p>
            Prototype interaction patterns for grounding, action control, citations, visual reasoning, task handoff,
            undo/retry, and confidence disclosure.
          </p>
        </div>
        <div class="autodesk-step">
          <h3>Days 61–90</h3>
          <p>
            Document reusable patterns, align design/product/engineering language, test against expert-user workflows,
            and operationalize adoption across teams.
          </p>
        </div>
      </div>
    </section>

    <section class="autodesk-section" aria-labelledby="pov-title">
      <div class="autodesk-pov">
        <div>
          <p class="autodesk-kicker">Point of view</p>
          <h2 id="pov-title">Autodesk Assistant should protect authorship.</h2>
        </div>
        <p>
          In professional creative and technical tools, AI cannot be treated as a replacement for judgment. The experience
          should help users move faster while preserving orientation, authorship, and accountability. The strongest
          assistant is not the one that answers the most. It is the one that helps a professional make the next defensible move.
        </p>
      </div>
      <div class="autodesk-thesis">
        <h3>Core pattern thesis</h3>
        <p>
          Every AI action needs a visible state: what it understood, what it changed, what evidence supports it, what can
          be reversed, and what the user still owns.
        </p>
      </div>
    </section>

    <section class="autodesk-closing" aria-label="Closing contact section">
      <div>
        <p class="autodesk-kicker">Nikhil Khedkar · Toronto</p>
        <h2>Principal Experience Designer candidate for Autodesk Assistant.</h2>
      </div>
      <div class="autodesk-actions autodesk-actions--dark">
        <a href="mailto:nickhilster@gmail.com">Email</a>
        <a href="https://www.linkedin.com/in/nikhil-khedkar" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href="https://www.nikdesign.ca/" target="_blank" rel="noopener noreferrer">Portfolio ↗</a>
      </div>
    </section>
  </article>
</BlogLayout>

<style>
  .autodesk-application {
    --autodesk-ink: #111111;
    --autodesk-muted: #5f6360;
    --autodesk-line: #d9d9d6;
    --autodesk-paper: #f7f6f2;
    --autodesk-panel: #ffffff;
    --autodesk-accent: #00a884;
    background: var(--autodesk-paper);
    color: var(--autodesk-ink);
    border: 1px solid var(--autodesk-line);
    overflow: hidden;
  }

  .autodesk-hero {
    background: #111111;
    color: #ffffff;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: 48px;
    align-items: end;
    padding: clamp(56px, 8vw, 96px) clamp(24px, 5vw, 72px);
  }

  .autodesk-kicker,
  .autodesk-card-label {
    color: #6f7773;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  .autodesk-hero .autodesk-kicker {
    color: #bfc7c3;
  }

  .autodesk-hero h1,
  .autodesk-section h2,
  .autodesk-closing h2 {
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin: 0;
  }

  .autodesk-hero h1 {
    font-size: clamp(3rem, 8vw, 5.8rem);
    max-width: 940px;
  }

  .autodesk-hero__lead {
    color: #e6e6e1;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.48;
    margin: 28px 0 0;
    max-width: 840px;
  }

  .autodesk-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .autodesk-actions a {
    border: 1px solid currentColor;
    color: inherit;
    display: inline-flex;
    font-weight: 800;
    padding: 13px 18px;
    text-decoration: none;
  }

  .autodesk-actions a:first-child {
    background: #ffffff;
    border-color: #ffffff;
    color: #111111;
  }

  .autodesk-actions--dark a:first-child {
    background: #111111;
    border-color: #111111;
    color: #ffffff;
  }

  .autodesk-signal-card {
    background: #242424;
    border: 1px solid #3c3c3c;
    padding: 28px;
  }

  .autodesk-signal-card p:last-child {
    color: #d5d5d0;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }

  .autodesk-section {
    padding: clamp(48px, 7vw, 84px) clamp(24px, 5vw, 72px);
  }

  .autodesk-section--ruled {
    border-top: 1px solid var(--autodesk-line);
  }

  .autodesk-section--light {
    background: #ffffff;
    border-block: 1px solid var(--autodesk-line);
  }

  .autodesk-section__intro {
    max-width: 860px;
    margin-bottom: 34px;
  }

  .autodesk-section h2,
  .autodesk-closing h2 {
    font-size: clamp(2.25rem, 5.8vw, 4.5rem);
  }

  .autodesk-grid,
  .autodesk-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .autodesk-card {
    background: var(--autodesk-panel);
    border: 1px solid var(--autodesk-line);
    min-height: 220px;
    padding: 26px;
  }

  .autodesk-card h3,
  .autodesk-step h3,
  .autodesk-work-row h3,
  .autodesk-thesis h3 {
    color: var(--autodesk-ink);
    font-size: 1.35rem;
    line-height: 1.1;
    margin: 0 0 14px;
  }

  .autodesk-card p:not(.autodesk-card-label),
  .autodesk-step p,
  .autodesk-work-row p,
  .autodesk-pov p,
  .autodesk-thesis p {
    color: var(--autodesk-muted);
    line-height: 1.6;
    margin: 0;
  }

  .autodesk-work-list {
    border-bottom: 1px solid var(--autodesk-line);
  }

  .autodesk-work-row {
    border-top: 1px solid var(--autodesk-line);
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(180px, 260px) minmax(0, 1fr) 120px;
    padding: 26px 0;
  }

  .autodesk-work-row a {
    color: var(--autodesk-ink);
    font-weight: 800;
  }

  .autodesk-step {
    border-left: 4px solid #111111;
    padding-left: 22px;
  }

  .autodesk-pov {
    background: #ffffff;
    border: 1px solid var(--autodesk-line);
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 34px;
    padding: clamp(28px, 5vw, 44px);
  }

  .autodesk-thesis {
    border: 1px solid var(--autodesk-line);
    border-top: 0;
    padding: clamp(24px, 4vw, 34px);
  }

  .autodesk-closing {
    background: #111111;
    color: #ffffff;
    display: flex;
    gap: 32px;
    justify-content: space-between;
    padding: clamp(38px, 6vw, 64px) clamp(24px, 5vw, 72px);
  }

  .autodesk-closing .autodesk-kicker {
    color: #bfc7c3;
  }

  @media (max-width: 860px) {
    .autodesk-hero,
    .autodesk-grid,
    .autodesk-steps,
    .autodesk-work-row,
    .autodesk-pov,
    .autodesk-closing {
      grid-template-columns: 1fr;
    }

    .autodesk-closing {
      display: grid;
    }
  }
</style>
