---
import { marked } from '../lib/marked-config.ts';
import { processCallouts } from '../lib/callouts.ts';
import BlogLayout from '../layouts/BlogLayout.astro';
import { getGeometricThumbnailUrl } from '../lib/thumbnail.ts';
import AgentEvolution from '../components/AgentEvolution.astro';
import DataValuePyramid from '../components/DataValuePyramid.astro';
import MultiAgentFlow from '../components/MultiAgentFlow.astro';
import AugmentationPatterns from '../components/AugmentationPatterns.astro';
import ComplianceRequirements from '../components/ComplianceRequirements.astro';
import DataValueBreakdown from '../components/DataValueBreakdown.astro';
import SOPToAgent from '../components/SOPToAgent.astro';
import PromptQuality from '../components/PromptQuality.astro';
import WorkflowDiagram from '../components/WorkflowDiagram.astro';
import CollaborationGradient from '../components/CollaborationGradient.astro';

const { slug } = Astro.params as { slug: string };
const apiBase =
  import.meta.env.SITE_API_BASE ??
  (import.meta.env.DEV ? 'http://localhost:3000' : 'https://teambotics.app');

type Post = {
  id: string;
  slug: string;
  title: string;
  excerpt: string;
  content: string;
  author: string;
  tags: string[];
  cover_image_url: string | null;
  published_at: string | null;
};

let post: Post | null = null;
let fetchError: string | null = null;

try {
  const res = await fetch(`${apiBase}/api/blog/posts/${encodeURIComponent(slug)}`);
  if (res.status === 404) {
    return Astro.redirect('/404', 404);
  }
  if (!res.ok) throw new Error(`API responded ${res.status}`);
  const data = (await res.json()) as { post: Post };
  post = data.post ?? null;
} catch (err) {
  fetchError = err instanceof Error ? err.message : 'Failed to load post.';
}

if (!post && !fetchError) {
  return Astro.redirect('/404', 404);
}

const rawHtml = post ? await marked.parse(post.content) : '';
const renderedContent = processCallouts(rawHtml);
---

{fetchError ? (
  <BlogLayout title="Error — Teambotics Blog">
    <div class="blog-post">
      <p style="color: var(--color-text-secondary);">Could not load this post. Please try again shortly.</p>
      <a href="/" class="blog-post__back">← Back to all posts</a>
    </div>
  </BlogLayout>
) : post ? (
  <BlogLayout
    title={`${post.title} — Teambotics Blog`}
    description={post.excerpt}
    ogImage={post.cover_image_url ?? undefined}
  >
    <article class="blog-post">
      <a href="/" class="blog-post__back">← All posts</a>

      <!--
        Mobile-first layout: title & meta FIRST, then cover image.
        This means on phones, readers see the post title above the fold
        instead of burning their screen on a thumbnail they just saw
        on the index page.
      -->
      <header class="blog-post__header">
        {post.tags.length > 0 && (
          <div class="blog-post__tags">
            {post.tags.map((tag) => (
              <span class="blog-post__tag">{tag}</span>
            ))}
          </div>
        )}

        <h1 class="blog-post__title">{post.title}</h1>

      </header>

      <!-- Cover image comes AFTER the header (title-first on mobile) -->
      <img
        src={post.cover_image_url ?? getGeometricThumbnailUrl(post.slug)}
        alt={post.title}
        class="blog-post__cover"
        loading="eager"
        decoding="async"
        width="1280"
        height="720"
      />

      {/* Interactive component BEFORE prose body — mobile-first: visual hook first, reading second */}
      {slug === 'agentic-ai-beyond-chatbots' && <AgentEvolution />}
      {slug === 'operational-data-ai-value' && <DataValuePyramid />}
      {slug === 'multi-agent-systems-workflow' && <MultiAgentFlow />}
      {slug === 'ai-augmentation-frontline-operations' && <AugmentationPatterns />}
      {slug === 'applied-ai-regulated-environments' && <ComplianceRequirements />}
      {slug === 'ai-value-existing-data' && <DataValueBreakdown />}
      {slug === 'sops-to-ai-agents' && <SOPToAgent />}
      {slug === 'prompt-engineering-operational-skill' && <PromptQuality />}
      {slug === 'llms-structured-automation-workflows' && <WorkflowDiagram />}
      {slug === 'designing-human-ai-teams' && <CollaborationGradient />}

      <div class="blog-post__body" set:html={renderedContent} />
    </article>
  </BlogLayout>
) : null}
