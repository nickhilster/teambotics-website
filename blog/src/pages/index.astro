---
import BlogLayout from '../layouts/BlogLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getStaticBlogPostSummaries } from '../data/static-posts.ts';
import { getExecutiveBlogPostSummaries } from '../data/executive-overrides.ts';
import { getApiBase } from '../lib/get-post.ts';
import { getAllPosts, type PostSummary } from '../lib/get-all-posts.ts';

const apiBase = getApiBase(import.meta.env);

const selectedTag = Astro.url.searchParams.get('tag') ?? null;

let allPosts: PostSummary[] = [];
let fetchError: string | null = null;

try {
  allPosts = await getAllPosts(apiBase);
} catch (err) {
  fetchError = err instanceof Error ? err.message : 'Failed to load posts.';
  allPosts = [...getExecutiveBlogPostSummaries(), ...getStaticBlogPostSummaries()].sort((a, b) =>
    new Date(b.published_at || 0).getTime() - new Date(a.published_at || 0).getTime()
  );
}

// Filter posts by tag if selected
const filteredPosts = selectedTag
  ? allPosts.filter(post => post.tags.includes(selectedTag))
  : allPosts;

// Get all unique tags
const allTags = Array.from(new Set(allPosts.flatMap(post => post.tags))).sort();
const activePostCount = filteredPosts.length;
const posts = filteredPosts;
---

<BlogLayout title={selectedTag ? `${selectedTag} — Teambotics Blog` : 'Teambotics Blog — Industrial Automation Insights'}>
  <div class="blog-index__hero">
    <span class="blog-index__eyebrow">Teambotics Blog</span>

    <div class="blog-index__hero-visual" aria-hidden="true">
      <div class="blog-index__hero-visual-shell">
        <div class="blog-index__hero-visual-grid"></div>
        <div class="blog-index__hero-visual-caption">
          <span class="blog-index__hero-visual-label">Signal scan</span>
          <strong>{selectedTag ? selectedTag : 'All topics'}</strong>
          <span>{activePostCount} articles in scope</span>
        </div>
        <div class="blog-index__hero-lanes">
          <div class="blog-index__hero-visual-beam"></div>
          <span class="blog-index__hero-lane blog-index__hero-lane--wide"></span>
          <span class="blog-index__hero-lane blog-index__hero-lane--mid"></span>
          <span class="blog-index__hero-lane blog-index__hero-lane--narrow"></span>
          <span class="blog-index__hero-node blog-index__hero-node--one"></span>
          <span class="blog-index__hero-node blog-index__hero-node--two"></span>
          <span class="blog-index__hero-node blog-index__hero-node--three"></span>
        </div>
      </div>
    </div>

    <div class="blog-index__hero-copy">
      <h1 class="blog-index__title">Operational insight for teams turning AI into dependable work</h1>
      <p class="blog-index__subtitle">
        Field notes, implementation patterns, and pragmatic guidance for automation programs that
        need to survive contact with real operations.
      </p>
      <div class="blog-index__hero-actions">
        {allTags.length > 0 && (
          <button
            type="button"
            class="blog-index__hero-button blog-index__hero-button--secondary"
            data-topic-toggle
          >
            Browse topics
          </button>
        )}
        <a href="/values" class="blog-index__hero-button blog-index__hero-button--secondary">
          Read our values
        </a>
      </div>
      <div class="blog-index__hero-metrics">
        <div class="blog-index__hero-metric">
          <span class="blog-index__hero-metric-label">Published posts</span>
          <strong class="blog-index__hero-metric-value">{allPosts.length}</strong>
        </div>
        <div class="blog-index__hero-metric">
          <span class="blog-index__hero-metric-label">Topic library</span>
          <strong class="blog-index__hero-metric-value">{allTags.length}</strong>
        </div>
        <div class="blog-index__hero-metric">
          <span class="blog-index__hero-metric-label">{selectedTag ? 'Active topic' : 'Current view'}</span>
          <strong class="blog-index__hero-metric-value">
            {selectedTag ? selectedTag : `${activePostCount} posts`}
          </strong>
        </div>
      </div>
    </div>
  </div>

  {allTags.length > 0 && (
    <details class="blog-index__filters" id="topics" open={Boolean(selectedTag)}>
      <summary class="blog-index__filters-fab">
        <span class="blog-index__filters-fab-label">Topics</span>
        <strong class="blog-index__filters-fab-value">{selectedTag ?? 'All topics'}</strong>
        <span class="blog-index__filters-fab-count">{allTags.length}</span>
      </summary>
      <div class="blog-index__filters-panel">
        <div class="blog-index__filters-panel-header">
          <div>
            <div class="blog-index__filter-label">Browse by topic</div>
            <p class="blog-index__filters-panel-copy">
              Narrow the feed without giving the filter bar the whole stage.
            </p>
          </div>
          {selectedTag && <a href="/" class="blog-index__filters-reset">Clear</a>}
        </div>
        <div class="blog-index__filter-tags">
          <a
            href="/"
            class={`blog-index__filter-tag ${!selectedTag ? 'blog-index__filter-tag--active' : ''}`}
          >
            All topics
          </a>
          {allTags.map((tag) => (
            <a
              href={`/?tag=${encodeURIComponent(tag)}`}
              class={`blog-index__filter-tag ${selectedTag === tag ? 'blog-index__filter-tag--active' : ''}`}
            >
              {tag}
            </a>
          ))}
        </div>
      </div>
    </details>
  )}

  <script>
    const topicToggle = document.querySelector('[data-topic-toggle]');
    const topicDetails = document.querySelector('.blog-index__filters');

    if (topicToggle instanceof HTMLButtonElement && topicDetails instanceof HTMLDetailsElement) {
      topicToggle.addEventListener('click', () => {
        topicDetails.open = !topicDetails.open;
        topicDetails.querySelector('summary')?.focus();
      });
    }
  </script>

  {fetchError && allPosts.length === 0 ? (
    <p style="color: var(--color-text-secondary);">Could not load posts right now. Please try again shortly.</p>
  ) : filteredPosts.length === 0 ? (
    <p class="blog-empty">
      {selectedTag ? `No posts found for "${selectedTag}". ` : 'No posts yet — '}
      <a href="/">Browse all topics</a>
    </p>
  ) : (
    <div class="blog-post-grid" id="posts">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  )}
</BlogLayout>
