{
  "name": "teambotics-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm translations:sync",
    "pretypecheck": "pnpm translations:check",
    "content:watch": "tsx scripts/watch-translations.ts",
    "content:sync": "pnpm translations:sync && pnpm typecheck",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "translations:bootstrap": "tsx scripts/bootstrap-translations.ts",
    "translations:sync": "tsx scripts/sync-translations.ts",
    "translations:check": "tsx scripts/sync-translations.ts --check",
    "chat:seed": "tsx scripts/seed-teambotics-knowledge.ts",
    "chat:seed:dry-run": "tsx scripts/seed-teambotics-knowledge.ts --dry-run",
    "chat:ingest:github": "tsx scripts/ingest-github-knowledge.ts",
    "blog:seed": "tsx scripts/seed-blog-posts.ts",
    "blog:seed:ai-2026": "tsx scripts/seed-blog-posts-ai-2026.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@neondatabase/serverless": "^1.1.0",
    "@octokit/rest": "^20.1.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "lucide-react": "^1.9.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
